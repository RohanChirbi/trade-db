# Copy this file to .env.local and replace every CHANGE_ME.
# Never commit .env.local. This example file is safe to commit.
# Use letters and digits only in passwords so they work inside connection URLs.

# --- PostgreSQL container (admin account, used for migrations only) ---
POSTGRES_USER=trading_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trading_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- PostgreSQL app roles (created later by sql/03_roles.sql using these values) ---
APP_DB_USER=trading_app
APP_DB_PASSWORD=CHANGE_ME
READONLY_DB_USER=trading_readonly
READONLY_DB_PASSWORD=CHANGE_ME
# Keep these in sync with the user, password and database name above
DATABASE_URL=postgresql://trading_app:CHANGE_ME@localhost:5432/trading_db
DATABASE_URL_READONLY=postgresql://trading_readonly:CHANGE_ME@localhost:5432/trading_db

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGODB_DB=trading_surveillance
# Keep in sync with the root username and password above
MONGODB_URI=mongodb://mongo_admin:CHANGE_ME@localhost:27017/?authSource=admin

# --- Next.js auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
AUTH_URL=http://localhost:3000

# --- Seed users for the demo (read by the seed script, never hard-coded) ---
SEED_TRADER_PASSWORD=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
